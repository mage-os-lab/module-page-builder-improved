<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- "Edit with Page Builder": the page's content is in a fieldset that starts closed. -->
        <referenceContainer name="before.body.end">
            <block class="Magento\Backend\Block\Template" name="mageos.pagebuilder.ui.edit_with_page_builder"
                   template="MageOS_PageBuilderUi::edit-with-page-builder.phtml">
                <arguments>
                    <argument name="fieldset" xsi:type="string">cms_page_form.cms_page_form.content</argument>
                    <argument name="view_model" xsi:type="object">MageOS\PageBuilderUi\ViewModel\EditWithPageBuilder</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
