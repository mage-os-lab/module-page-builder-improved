<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- "Edit with Page Builder" in the CMS pages' and blocks' grids. -->
    <virtualType name="MageOS\PageBuilderUi\Plugin\AddEditWithPageBuilderAction\CmsPage"
                 type="MageOS\PageBuilderUi\Plugin\AddEditWithPageBuilderAction">
        <arguments>
            <argument name="editUrlPath" xsi:type="string">cms/page/edit</argument>
            <argument name="idField" xsi:type="string">page_id</argument>
        </arguments>
    </virtualType>
    <virtualType name="MageOS\PageBuilderUi\Plugin\AddEditWithPageBuilderAction\CmsBlock"
                 type="MageOS\PageBuilderUi\Plugin\AddEditWithPageBuilderAction">
        <arguments>
            <argument name="editUrlPath" xsi:type="string">cms/block/edit</argument>
            <argument name="idField" xsi:type="string">block_id</argument>
        </arguments>
    </virtualType>

    <type name="Magento\Cms\Ui\Component\Listing\Column\PageActions">
        <plugin name="mageos_page_builder_ui_edit_with_page_builder"
                type="MageOS\PageBuilderUi\Plugin\AddEditWithPageBuilderAction\CmsPage"/>
    </type>
    <type name="Magento\Cms\Ui\Component\Listing\Column\BlockActions">
        <plugin name="mageos_page_builder_ui_edit_with_page_builder"
                type="MageOS\PageBuilderUi\Plugin\AddEditWithPageBuilderAction\CmsBlock"/>
    </type>
</config>
