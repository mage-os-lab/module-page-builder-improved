<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- data-mageos-layout marks the column groups saved with the module (content_type/column_group.xml). The CMS
         HTML validator only allows the attributes listed here: without it, every save of content with Columns
         warns about restricted elements, and is refused when cms/wysiwyg/force_valid is on. -->
    <virtualType name="DefaultWYSIWYGValidator">
        <arguments>
            <argument name="allowedAttributes" xsi:type="array">
                <item name="data-mageos-layout" xsi:type="string">data-mageos-layout</item>
            </argument>
        </arguments>
    </virtualType>
</config>
