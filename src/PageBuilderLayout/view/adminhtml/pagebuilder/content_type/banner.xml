<?xml version="1.0"?>
<!--
    The Tablet view's form of core's "banner" element, like its Mobile one.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_PageBuilder:etc/content_type.xsd">
    <type name="banner">
        <breakpoints>
            <breakpoint name="tablet">
                <form>pagebuilder_banner_tablet_form</form>
            </breakpoint>
        </breakpoints>
    </type>
</config>
